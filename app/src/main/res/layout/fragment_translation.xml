<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/siject_bg"
    android:orientation="vertical">

    <!-- Camera preview area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <com.signlanguage.translator.ui.views.LandmarkOverlayView
            android:id="@+id/landmarkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- FPS pill badge -->
        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_md"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/siject_text"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- Bottom panel with rounded top corners -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_top_rounded">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_md">

            <!-- Drag handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:background="@drawable/bg_drag_handle" />

            <!-- Candidates section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SIJECT.SectionHeader"
                    android:text="@string/recognized_words_title" />

                <!-- Primary candidate with accent left border -->
                <TextView
                    android:id="@+id/candidateOneText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_candidate_primary"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:text="@string/candidate_placeholder"
                    android:textColor="@color/siject_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Confidence bar -->
                <com.signlanguage.translator.ui.views.ConfidenceBar
                    android:id="@+id/confidenceBar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp" />

                <!-- Latency -->
                <TextView
                    android:id="@+id/latencyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/siject_text_muted"
                    android:textSize="11sp" />

                <!-- Secondary candidates row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/candidateTwoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@color/siject_surface_elevated"
                        android:padding="@dimen/spacing_sm"
                        android:text="@string/candidate_placeholder"
                        android:textColor="@color/siject_text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/candidateThreeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@color/siject_surface_elevated"
                        android:padding="@dimen/spacing_sm"
                        android:text="@string/candidate_placeholder"
                        android:textColor="@color/siject_text_muted"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@color/siject_divider" />

            <!-- Translation section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SIJECT.SectionHeader"
                    android:text="@string/translated_sentence_title" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_sm"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/siject_surface_elevated">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/sentenceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/translated_sentence_placeholder"
                            android:textColor="@color/siject_text"
                            android:textSize="16sp" />

                        <ProgressBar
                            android:id="@+id/translationProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/apiStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="@color/siject_warning"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Action row: TTS + Copy + Refresh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playTtsButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/play_tts"
                        android:textColor="@color/siject_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyTranslationButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/copy_translation"
                        android:textColor="@color/siject_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refreshTranslationButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="@color/siject_text"
                        android:text="@string/refresh_translation"
                        android:textColor="@color/siject_text"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Nav row: Settings + History -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/settings"
                        android:textColor="@color/siject_text"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="@color/siject_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/historyButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/history"
                        android:textColor="@color/siject_text"
                        app:icon="@drawable/ic_history"
                        app:iconTint="@color/siject_text" />

                </LinearLayout>

                <!-- Debug row (secondary) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/debugButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/debug"
                        android:textColor="@color/siject_text_muted"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_bug"
                        app:iconTint="@color/siject_text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pipelineDemoButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/run_pipeline_demo"
                        android:textColor="@color/siject_text_muted"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_bug"
                        app:iconTint="@color/siject_text_muted" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
