<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/siject_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <com.signlanguage.translator.ui.views.LandmarkOverlayView
            android:id="@+id/landmarkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_md"
            android:background="@color/siject_surface"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs"
            android:textColor="@color/siject_text"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recognized_words_title"
            android:textColor="@color/siject_text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/candidateOneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@color/siject_surface"
            android:padding="@dimen/spacing_sm"
            android:text="@string/candidate_placeholder"
            android:textColor="@color/siject_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/candidateTwoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@color/siject_surface"
            android:padding="@dimen/spacing_sm"
            android:text="@string/candidate_placeholder"
            android:textColor="@color/siject_text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/candidateThreeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@color/siject_surface"
            android:padding="@dimen/spacing_sm"
            android:text="@string/candidate_placeholder"
            android:textColor="@color/siject_text_muted"
            android:textSize="15sp" />

        <com.signlanguage.translator.ui.views.ConfidenceBar
            android:id="@+id/confidenceBar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/latencyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/siject_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/translated_sentence_title"
            android:textColor="@color/siject_text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sentenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@color/siject_surface"
            android:padding="@dimen/spacing_md"
            android:text="@string/translated_sentence_placeholder"
            android:textColor="@color/siject_text_muted"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/translationProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/spacing_xs"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/apiStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/siject_warning"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="@color/siject_text"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/siject_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/history"
                android:textColor="@color/siject_text"
                app:icon="@drawable/ic_history"
                app:iconTint="@color/siject_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debugButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/debug"
                android:textColor="@color/siject_text"
                app:icon="@drawable/ic_bug"
                app:iconTint="@color/siject_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playTtsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/play_tts"
                android:textColor="@color/siject_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyTranslationButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/copy_translation"
                android:textColor="@color/siject_text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshTranslationButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/refresh_translation"
            android:textColor="@color/siject_text"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/siject_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pipelineDemoButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/run_pipeline_demo"
            android:textColor="@color/siject_text"
            app:icon="@drawable/ic_bug"
            app:iconTint="@color/siject_text" />
    </LinearLayout>
</LinearLayout>
